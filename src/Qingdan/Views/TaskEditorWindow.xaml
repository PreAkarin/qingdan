<Window x:Class="Qingdan.Views.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑待办"
        Width="560"
        SizeToContent="Height"
        MaxHeight="760"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
        <Style x:Key="UrgentSegmentRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadioStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource UrgentSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource UrgentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DoneSegmentRadioStyle" TargetType="RadioButton" BasedOn="{StaticResource SegmentRadioStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{StaticResource DoneSoftBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource DoneBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="{StaticResource SurfaceBrush}" BorderBrush="#E3E7F1" BorderThickness="1"
            CornerRadius="18" Effect="{StaticResource DialogShadow}">
        <Grid Margin="24,22,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="编辑待办" Style="{StaticResource DialogTitleStyle}" />
                    <TextBlock Text="把内容、分类和状态调整到合适的位置"
                               Style="{StaticResource DialogSubtitleStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Top"
                        ToolTip="关闭" Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="待办内容" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,7" />
                <TextBox x:Name="TitleInput" Style="{StaticResource AppTextBoxStyle}"
                         Height="42" FontSize="14" MaxLength="200" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="所属分类" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,7" />
                    <ComboBox x:Name="CategoryCombo" Style="{StaticResource AppComboBoxStyle}" Height="40" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="状态" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,7" />
                    <Border Background="#F6F7FB" CornerRadius="10" Padding="3" Height="40">
                        <UniformGrid Columns="3">
                            <RadioButton x:Name="PendingRadio" GroupName="TaskStatus" Style="{StaticResource SegmentRadioStyle}"
                                         Height="34" Content="未处理" FontSize="11.5" />
                            <RadioButton x:Name="UrgentRadio" GroupName="TaskStatus" Style="{StaticResource UrgentSegmentRadioStyle}"
                                         Height="34" Content="紧急" FontSize="11.5" Margin="3,0" />
                            <RadioButton x:Name="DoneRadio" GroupName="TaskStatus" Style="{StaticResource DoneSegmentRadioStyle}"
                                         Height="34" Content="已处理" FontSize="11.5" />
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <TextBlock Text="备注（可选）" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,7" />
                <TextBox x:Name="NotesInput" Style="{StaticResource MultilineTextBoxStyle}" Height="94"
                         MaxLength="2000" />
            </StackPanel>

            <TextBlock x:Name="MetaText" Grid.Row="4" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                       Margin="2,14,0,0" />

            <TextBlock x:Name="ErrorText" Grid.Row="5" FontSize="11.5" Foreground="{StaticResource DangerBrush}"
                       Margin="2,10,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <Grid Grid.Row="6" Margin="0,20,0,0">
                <Button x:Name="DeleteButton" Style="{StaticResource GhostButtonStyle}"
                        HorizontalAlignment="Left" Foreground="{StaticResource DangerBrush}"
                        Padding="8,0" Click="Delete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBlock Text="删除待办" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消"
                            Height="36" MinWidth="76" Click="Cancel_Click" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="保存修改"
                            Height="36" MinWidth="94" Margin="9,0,0,0" IsDefault="True"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
