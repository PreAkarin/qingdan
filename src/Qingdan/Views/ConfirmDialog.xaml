<Window x:Class="Qingdan.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="454"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Border Margin="20" Background="{StaticResource SurfaceBrush}" BorderBrush="#E3E7F1" BorderThickness="1"
            CornerRadius="18" Effect="{StaticResource DialogShadow}">
        <Grid Margin="26,24,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource DangerSoftBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="TitleText" Text="确认操作" Style="{StaticResource DialogTitleStyle}"
                               VerticalAlignment="Center" Margin="13,0,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Top"
                        ToolTip="关闭" Click="Cancel_Click" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Text="确定要继续吗？" TextWrapping="Wrap"
                       FontSize="12.5" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="53,11,4,0" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消"
                        Height="36" MinWidth="76" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource DangerButtonStyle}" Content="删除"
                        Height="36" MinWidth="82" Margin="9,0,0,0" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
