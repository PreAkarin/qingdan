<Window x:Class="Qingdan.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 · 清单"
        Width="780"
        Height="760"
        MinHeight="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />

        <Style x:Key="SettingsSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="22,20" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>

        <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="SettingsRowDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SkinItemContainerStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="146" />
            <Setter Property="Height" Value="94" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="OuterRing" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="15" Padding="2">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OuterRing" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse Fill="White" Stroke="#D7DCE8" StrokeThickness="1">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.16" Color="#1B2542" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="6" Height="6" Fill="{StaticResource BrandBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderDecreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="{StaticResource BrandBrush}" CornerRadius="2" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderIncreaseButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Height="4" Background="#E5E8F0" CornerRadius="2" VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AppSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderDecreaseButtonStyle}"
                                                  Command="{x:Static Slider.DecreaseLarge}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderIncreaseButtonStyle}"
                                                  Command="{x:Static Slider.IncreaseLarge}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="18" Background="{StaticResource SurfaceBrush}" BorderBrush="#E3E7F1" BorderThickness="1"
            CornerRadius="20" Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="26,22,20,12"
                  Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource BrandSoftBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="17"
                               Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="设置与外观" FontSize="21" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="让清单更贴近你的桌面习惯" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Top"
                        ToolTip="关闭设置" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="26,2,18,0" Padding="0,0,8,0">
                <StackPanel>
                    <!-- Desk widget -->
                    <Border Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="桌面悬浮窗" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Text="常驻桌面底层，随叫随到" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ShowWidget, Mode=TwoWay}"
                                          ToolTip="显示或隐藏桌面悬浮窗" />
                            </Grid>

                            <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="10" Padding="12,10"
                                    Margin="0,15,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="{StaticResource BrandBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                                    <TextBlock Grid.Column="1" FontSize="10.5" LineHeight="17"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                               Text="悬浮窗位于普通窗口下方，任何软件都可以盖住它；回到桌面或按 Win+D 时，它会稳定地留在桌面上。主窗口关闭后，程序仍会在托盘运行。" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,20,0,14">
                                <TextBlock Text="悬浮窗皮肤" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="点击切换，立即生效" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <ListBox x:Name="SkinList" Background="Transparent" BorderThickness="0"
                                     SelectedValuePath="Id"
                                     SelectedValue="{Binding Settings.WidgetSkinId, Mode=TwoWay}"
                                     ItemContainerStyle="{StaticResource SkinItemContainerStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Background="{Binding BackgroundPreview}"
                                                BorderBrush="#22FFFFFF" BorderThickness="1" Padding="12,10">
                                            <Grid>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="6" Height="6" Fill="{Binding AccentPreview}"
                                                                 VerticalAlignment="Center" Margin="0,0,7,0" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{Binding TextPreview}" />
                                                    </StackPanel>
                                                    <Border Height="3" Width="72" CornerRadius="2" Background="{Binding AccentPreview}"
                                                            Opacity="0.35" Margin="0,12,0,0" HorizontalAlignment="Left" />
                                                    <Border Height="3" Width="94" CornerRadius="2" Background="{Binding TextPreview}"
                                                            Opacity="0.16" Margin="0,6,0,0" HorizontalAlignment="Left" />
                                                    <TextBlock Text="{Binding Description}" FontSize="9"
                                                               Foreground="{Binding TextPreview}" Opacity="0.62" Margin="0,10,0,0" />
                                                </StackPanel>
                                                <Border Width="18" Height="18" CornerRadius="9"
                                                        Background="{StaticResource BrandBrush}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="9" Foreground="White" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="230" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="背景透明度" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="只调整悬浮窗背景，文字始终保持清晰"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Slider Style="{StaticResource AppSliderStyle}"
                                            Width="170"
                                            Minimum="0.35" Maximum="1.0"
                                            SmallChange="0.01" LargeChange="0.08"
                                            Value="{Binding Settings.WidgetBackgroundOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="{Binding Settings.WidgetBackgroundOpacity, Converter={StaticResource PercentConverter}}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                                               Width="38" TextAlignment="Right" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,14" />

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="显示已完成事项" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="开启后，已完成的事项会收在悬浮窗列表底部"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.ShowCompletedInWidget, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- General -->
                    <Border Style="{StaticResource SettingsSectionStyle}">
                        <StackPanel>
                            <TextBlock Text="通用" FontSize="15" FontWeight="Bold" Margin="0,0,0,16" />

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="开机自动启动" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="登录 Windows 后在托盘静默启动，桌面悬浮窗自动出现"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource ToggleSwitchStyle}" HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.AutoStart, Mode=TwoWay}" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,14" />

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="数据保存位置" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="{Binding Store.DataFilePath}" FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" Margin="0,5,0,0"
                                               TextTrimming="CharacterEllipsis" MaxWidth="470" HorizontalAlignment="Left" />
                                </StackPanel>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="打开文件夹"
                                        Height="32" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Click="OpenDataFolder_Click" />
                            </Grid>

                            <Border Style="{StaticResource DividerStyle}" Margin="0,16,0,14" />

                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="关闭主窗口" Style="{StaticResource SettingsRowTitleStyle}" />
                                    <TextBlock Text="主窗口会隐藏到系统托盘，悬浮窗和后台数据服务继续工作"
                                               Style="{StaticResource SettingsRowDescriptionStyle}" />
                                </StackPanel>
                                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="8" Padding="9,5"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="保留在托盘" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="2,2,0,8">
                        <StackPanel>
                            <TextBlock Text="所有更改都会自动保存" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="遇到问题可先退出程序，再从开始菜单重新打开。" FontSize="10"
                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButtonStyle}" Content="恢复默认外观"
                                    Height="32" Click="ResetAppearance_Click" />
                            <Button Style="{StaticResource GhostButtonStyle}" Content="退出清单"
                                    Height="32" Foreground="{StaticResource DangerBrush}" Click="ExitApp_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="28,8,28,18">
                <TextBlock Text="{Binding AppVersion, StringFormat=清单 v{0}}" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="托盘菜单也可以快速切换悬浮窗" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="完成"
                            Height="34" MinWidth="78" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
