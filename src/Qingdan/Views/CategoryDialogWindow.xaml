<Window x:Class="Qingdan.Views.CategoryDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="分类"
        Width="466"
        SizeToContent="Height"
        MaxHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ColorSwatchItemStyle" TargetType="ListBoxItem">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="21" Padding="5">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
    </Window.Resources>

    <Border Margin="20" Background="{StaticResource SurfaceBrush}" BorderBrush="#E3E7F1" BorderThickness="1"
            CornerRadius="18" Effect="{StaticResource DialogShadow}">
        <Grid Margin="24,22,24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DialogTitle" Text="新建分类" Style="{StaticResource DialogTitleStyle}" />
                    <TextBlock x:Name="DialogSubtitle" Text="给清单一个清晰的归处"
                               Style="{StaticResource DialogSubtitleStyle}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                        FontFamily="{StaticResource IconFont}" FontSize="11"
                        VerticalAlignment="Top" ToolTip="关闭" Click="Cancel_Click" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="分类名称" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,7" />
                <TextBox x:Name="NameInput" Style="{StaticResource AppTextBoxStyle}"
                         Height="42" MaxLength="16" FontSize="14" />
                <TextBlock Text="最多 16 个字符，分类名称不能重复" FontSize="10.5"
                           Foreground="{StaticResource TextMutedBrush}" Margin="2,7,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,22,0,0">
                <TextBlock Text="标记颜色" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,8" />
                <ListBox x:Name="ColorList" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding Colors}"
                         ItemContainerStyle="{StaticResource ColorSwatchItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Fill="{Binding Converter={StaticResource HexToBrushConverter}}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <TextBlock x:Name="ErrorText" Grid.Row="3" FontSize="11.5" Foreground="{StaticResource DangerBrush}"
                       Margin="2,12,0,0" Visibility="Collapsed" TextWrapping="Wrap" />

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <TextBlock Text="分类会同步显示在主界面和桌面悬浮窗" FontSize="10"
                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消"
                            Height="36" MinWidth="76" Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButtonStyle}" Content="创建分类"
                            Height="36" MinWidth="90" Margin="9,0,0,0" IsDefault="True"
                            Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
