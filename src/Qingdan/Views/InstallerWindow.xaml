<Window x:Class="Qingdan.Views.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="安装 清单"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="680" Height="650"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
        <Style x:Key="SetupProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#E8EBF4" CornerRadius="4" />
                            <Border x:Name="PART_Indicator" Background="{StaticResource BrandBrush}" CornerRadius="4"
                                    HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OptionRowTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="OptionRowDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Border Margin="20" Background="{StaticResource SurfaceBrush}" BorderBrush="#E2E6F0" BorderThickness="1"
            CornerRadius="22" Effect="{StaticResource DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="26,20,20,0" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="36" Height="36">
                    <Border CornerRadius="11" Background="{StaticResource BrandGradientBrush}">
                        <Grid>
                            <Path Data="M 9.5 18.5 L 15 24 L 27 11" Stroke="White" StrokeThickness="2.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="4.5" Height="4.5" Fill="#FFC45E" HorizontalAlignment="Right"
                                     VerticalAlignment="Top" Margin="0,8,8,0" />
                        </Grid>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="安装 清单" FontSize="16" FontWeight="Bold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="QINGDAN SETUP" FontSize="8" Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <Button x:Name="CloseButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11"
                        VerticalAlignment="Top" ToolTip="关闭" Click="Close_Click" />
            </Grid>

            <!-- Install form -->
            <Grid x:Name="InstallFormPanel" Grid.Row="1" Margin="32,26,32,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="SETUP · 30 秒完成" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrandBrush}" />
                    <TextBlock Text="把重要的事，放在桌面。" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="轻巧的 Windows 待办清单，支持分类、紧急事项、桌面悬浮窗和开机自启。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,22,0,0">
                    <StackPanel>
                        <TextBlock Text="安装位置" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="1,0,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBox x:Name="InstallPathInput" Grid.Column="1" Style="{StaticResource AppTextBoxStyle}"
                                         Height="40" FontSize="12" Margin="0" />
                            </Grid>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="浏览…"
                                    Height="40" MinWidth="72" Margin="9,0,0,0" Click="Browse_Click" />
                        </Grid>
                        <TextBlock x:Name="DataPathHint" FontSize="9.8" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="1,8,0,0" TextWrapping="Wrap" />
                        <Border Style="{StaticResource DividerStyle}" Margin="0,15,0,13" />

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="创建桌面快捷方式" Style="{StaticResource OptionRowTitleStyle}" />
                                <TextBlock Text="在桌面放置一个「清单」图标" Style="{StaticResource OptionRowDescriptionStyle}" />
                            </StackPanel>
                            <CheckBox x:Name="DesktopShortcutCheck" Style="{StaticResource ToggleSwitchStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" />
                        </Grid>

                        <Grid Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="安装完成后打开清单" Style="{StaticResource OptionRowTitleStyle}" />
                                <TextBlock Text="立即体验悬浮窗和清单" Style="{StaticResource OptionRowDescriptionStyle}" />
                            </StackPanel>
                            <CheckBox x:Name="OpenAfterInstallCheck" Style="{StaticResource ToggleSwitchStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="True" />
                        </Grid>

                        <Border Style="{StaticResource DividerStyle}" Margin="0,15,0,13" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                       Foreground="{StaticResource DoneBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="开机自启会默认开启，安装后可在设置中随时关闭。" FontSize="10.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <TextBlock x:Name="InstallErrorText" FontSize="11.5" Foreground="{StaticResource DangerBrush}"
                               Visibility="Collapsed" TextWrapping="Wrap" Margin="2,10,0,0" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="无需管理员权限 · 数据保存在本机" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock x:Name="VersionText" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消"
                                Height="38" MinWidth="80" Click="Close_Click" />
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButtonStyle}" Content="开始安装"
                                Height="38" MinWidth="104" Margin="9,0,0,0" Click="Install_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Uninstall form -->
            <Grid x:Name="UninstallFormPanel" Grid.Row="1" Margin="32,26,32,24" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="UNINSTALL · 再见" FontSize="9.5" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" />
                    <TextBlock Text="和清单说再见。" FontSize="28" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="这会移除已安装的清单程序、快捷方式和开机启动项。"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="应用位置" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="UninstallPathText" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                        <Border Style="{StaticResource DividerStyle}" Margin="0,14,0,13" />
                        <TextBlock Text="清单数据" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="UninstallDataPathText" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}"
                                   Margin="0,7,0,0" TextWrapping="Wrap" />
                        <Border Style="{StaticResource DividerStyle}" Margin="0,14,0,13" />
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="同时删除清单数据" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}" />
                                <TextBlock Text="会永久删除所有分类、待办和设置，无法恢复"
                                           Style="{StaticResource OptionRowDescriptionStyle}" />
                            </StackPanel>
                            <CheckBox x:Name="DeleteDataCheck" Style="{StaticResource ToggleSwitchStyle}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                        <TextBlock Text="卸载时请保持其他清单窗口关闭。程序会先尝试关闭正在运行的实例，再清理文件。"
                                   FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="UninstallErrorText" FontSize="11.5" Foreground="{StaticResource DangerBrush}"
                               Visibility="Collapsed" TextWrapping="Wrap" Margin="2,10,0,0" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <TextBlock Text="之后仍可重新运行安装程序进行安装" FontSize="10"
                               Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消"
                                Height="38" MinWidth="80" Click="Close_Click" />
                        <Button x:Name="UninstallButton" Style="{StaticResource DangerButtonStyle}" Content="卸载清单"
                                Height="38" MinWidth="104" Margin="9,0,0,0" Click="Uninstall_Click" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Progress -->
            <Grid x:Name="ProgressPanel" Grid.Row="1" Margin="40,20,40,30" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Border Width="62" Height="62" CornerRadius="20" Background="{StaticResource BrandSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock x:Name="ProgressGlyph" Text="&#xE895;" FontFamily="{StaticResource IconFont}"
                                   FontSize="26" Foreground="{StaticResource BrandBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="ProgressTitle" Text="正在安装清单" FontSize="23" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock x:Name="ProgressStage" Text="正在准备…" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                    <ProgressBar x:Name="InstallProgressBar" Style="{StaticResource SetupProgressBarStyle}"
                                 Minimum="0" Maximum="100" Value="0" Width="420" Margin="0,26,0,0" />
                    <TextBlock x:Name="ProgressPercent" Text="0%" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="安装过程中请不要关闭窗口" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                </StackPanel>
            </Grid>

            <!-- Success -->
            <Grid x:Name="SuccessPanel" Grid.Row="1" Margin="40,20,40,30" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <Border Width="68" Height="68" CornerRadius="22" Background="{StaticResource DoneSoftBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{StaticResource DoneBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="SuccessTitle" Text="安装完成" FontSize="25" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock x:Name="SuccessMessage" Text="清单已经准备好陪你了。" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" />
                    <Border Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="13,10" Margin="24,22,24,0">
                        <TextBlock x:Name="SuccessPathText" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <ItemsControl x:Name="WarningsList" Margin="26,14,26,0" Visibility="Collapsed">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button x:Name="FinishButton" Style="{StaticResource PrimaryButtonStyle}" Content="完成"
                            Height="38" MinWidth="112" Margin="0,26,0,0" HorizontalAlignment="Center"
                            IsDefault="True" Click="Finish_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
