<Window x:Class="Qingdan.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:Qingdan.Common"
        xmlns:models="clr-namespace:Qingdan.Models"
        Title="清单"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1320" Height="840"
        MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
            <Style TargetType="MenuItem" BasedOn="{StaticResource AppMenuItemStyle}" />
            <Style TargetType="Separator" BasedOn="{StaticResource MenuSeparatorStyle}" />

            <Style x:Key="SidebarNavButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="common:UiProperties.CornerRadius" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{Binding Path=(common:UiProperties.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                                <Border x:Name="SelectionBar" Width="3" Height="18" CornerRadius="2"
                                        HorizontalAlignment="Left" Background="{StaticResource BrandLightBrush}"
                                        Opacity="0" />
                                <Border x:Name="HoverOverlay" Background="#FFFFFF" Opacity="0"
                                        CornerRadius="{Binding Path=(common:UiProperties.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Margin="12,0,10,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.055" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.09" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAllCategoriesSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SidebarGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextOnDarkMutedBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="common:UiProperties.CornerRadius" Value="8" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="ButtonBackground" Background="{TemplateBinding Background}" CornerRadius="8" />
                                <Border x:Name="HoverOverlay" Background="#FFFFFF" Opacity="0" CornerRadius="8" />
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.06" />
                                    <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SidebarCategoryItemStyle" TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="ItemBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TaskMoreButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="Opacity" Value="0.62" />
                <Setter Property="common:UiProperties.CornerRadius" Value="7" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ColumnAddButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                <Setter Property="common:UiProperties.CornerRadius" Value="7" />
            </Style>

            <Style x:Key="SearchFieldBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="EmptyStateGlyphStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="25" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <DataTemplate x:Key="TaskCardTemplate" DataType="{x:Type models:TodoItem}">
                <Border x:Name="TaskCardRoot"
                        Margin="0,0,0,10"
                        Padding="14"
                        CornerRadius="14"
                        BorderThickness="1"
                        Cursor="SizeAll"
                        PreviewMouseLeftButtonDown="TaskCard_PreviewMouseLeftButtonDown"
                        PreviewMouseMove="TaskCard_PreviewMouseMove"
                        PreviewMouseLeftButtonUp="TaskCard_PreviewMouseLeftButtonUp"
                        MouseLeftButtonDown="TaskCard_MouseLeftButtonDown">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                    <Setter Property="Background" Value="#FFFCFA" />
                                    <Setter Property="BorderBrush" Value="#F3D7D1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                    <Setter Property="Background" Value="#FBFCFD" />
                                    <Setter Property="BorderBrush" Value="#EDF0F4" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="#C9D2FF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource AppContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="标记为未处理" Click="MenuMarkPending_Click" />
                            <MenuItem Header="标记为紧急" Click="MenuMarkUrgent_Click" />
                            <MenuItem Header="标记为已完成" Click="MenuMarkDone_Click" />
                            <Separator />
                            <MenuItem Header="编辑待办…" InputGestureText="双击" Click="MenuEditTask_Click" />
                            <MenuItem Header="删除待办" Style="{StaticResource DangerMenuItemStyle}" Click="MenuDeleteTask_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="28" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0"
                                  Style="{StaticResource TaskCheckBoxStyle}"
                                  VerticalAlignment="Top"
                                  Margin="0,1,0,0"
                                  IsChecked="{Binding IsDone, Mode=OneWay}"
                                  Click="TaskCheck_Click"
                                  ToolTip="切换完成状态" />

                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding Title}"
                                   FontSize="13.5"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,0,4,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextDecorations" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                                            <Setter Property="TextDecorations" Value="Strikethrough" />
                                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                            <Setter Property="FontWeight" Value="Normal" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource TaskMoreButtonStyle}"
                                Content="&#xE712;"
                                FontFamily="{StaticResource IconFont}"
                                ToolTip="编辑待办"
                                Click="TaskMore_Click" />

                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{Binding NotesPreview}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding HasNotes, Converter={StaticResource BoolVisibility}}" />

                        <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#F6F7FB" CornerRadius="6" Padding="7,3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center"
                                             Fill="{Binding CategoryColor, Converter={StaticResource HexToBrushConverter}}" />
                                    <TextBlock Text="{Binding CategoryName}" FontSize="10.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="92" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource UrgentSoftBrush}" CornerRadius="6"
                                    Padding="6,3" Margin="6,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsUrgent, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="紧急" FontSize="10.5" Foreground="{StaticResource UrgentBrush}"
                                           FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Grid.Column="3" Text="{Binding TimeDisplay}"
                                       FontSize="10.5"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="SidebarCategoryTemplate" DataType="{x:Type models:Category}">
                <Border Background="Transparent" ToolTip="{Binding Name}">
                    <Border.ContextMenu>
                        <ContextMenu Style="{StaticResource AppContextMenuStyle}"
                                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="重命名分类…" Click="MenuRenameCategory_Click" />
                            <MenuItem Header="删除分类" Style="{StaticResource DangerMenuItemStyle}" Click="MenuDeleteCategory_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" HorizontalAlignment="Left"
                                 Fill="{Binding Color, Converter={StaticResource HexToBrushConverter}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="#D5DAE9"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding CountDisplay}" FontSize="10.5"
                                   Foreground="{StaticResource TextOnDarkMutedBrush}" VerticalAlignment="Center"
                                   Margin="8,0,0,0" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="254" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Sidebar ============================ -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <Grid>
                <Rectangle IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.15,0.0" GradientOrigin="0.15,0.0" RadiusX="0.85" RadiusY="0.65">
                            <GradientStop Color="#35468F" Offset="0" />
                            <GradientStop Color="#1C2136" Offset="0.55" />
                            <GradientStop Color="#141827" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <Grid Margin="18,22,18,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Background="Transparent" PreviewMouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="38" Height="38">
                            <Border CornerRadius="11" Background="{StaticResource BrandGradientBrush}">
                                <Grid>
                                    <Path Data="M 10 19.5 L 16 25.5 L 29 11.5"
                                          Stroke="White" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Ellipse Width="5" Height="5" Fill="#FFC45E"
                                             HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" />
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock Text="清单" FontSize="19" FontWeight="Bold" Foreground="White"
                                       FontFamily="{StaticResource AppFont}" />
                            <TextBlock Text="Q I N G D A N" FontSize="8" Foreground="#858EAA"
                                       FontFamily="{StaticResource AppFont}" Margin="1,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,28,0,0">
                        <TextBlock Text="工 作 台" Style="{StaticResource SectionLabelStyle}"
                                   Foreground="#737D9A" Margin="12,0,0,8" />
                        <Button x:Name="AllTasksButton"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                Click="AllTasksButton_Click"
                                ToolTip="查看全部分类">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Foreground="#9EA7C3" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="全部事项" FontSize="12.5"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#2B314A" CornerRadius="8" Padding="7,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActiveCount}" FontSize="10"
                                               Foreground="#B7BFD8" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,22,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="分 类" Style="{StaticResource SectionLabelStyle}" Foreground="#737D9A"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource SidebarIconButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Content="&#xE710;"
                                    ToolTip="新建分类"
                                    Click="AddCategoryButton_Click" />
                        </Grid>

                        <ListBox x:Name="CategoryList"
                                 Grid.Row="1"
                                 Margin="0,8,-5,0"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding Categories}"
                                 ItemTemplate="{StaticResource SidebarCategoryTemplate}"
                                 ItemContainerStyle="{StaticResource SidebarCategoryItemStyle}"
                                 SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="0,0,4,0">
                            <ListBox.Resources>
                                <Style TargetType="ScrollBar" BasedOn="{StaticResource SlimScrollBarStyle}" />
                            </ListBox.Resources>
                        </ListBox>

                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <TextBlock Text="右键分类可重命名或删除" FontSize="9.5" Foreground="#5E6885"
                                       Margin="12,0,0,6" />
                            <Button Style="{StaticResource SidebarGhostButtonStyle}"
                                    Click="AddCategoryButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                               VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="新建分类" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,16,0,0">
                        <Border Background="#1F253B" BorderBrush="#2A3048" BorderThickness="1"
                                CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="8" Background="#2A3150"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7C4;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                               Foreground="#AEB7FF" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="桌面悬浮窗" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="#E9ECF6" />
                                    <TextBlock FontSize="9.5" Foreground="#7F89A5" Margin="0,2,0,0"
                                               Text="{Binding Settings.ShowWidget, Converter={StaticResource BoolToTextConverter}}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding Settings.ShowWidget, Mode=TwoWay}"
                                          ToolTip="显示或隐藏桌面悬浮窗" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,10,0,0">
                            <Button Style="{StaticResource SidebarGhostButtonStyle}" Click="OpenSettings_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                               VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock Text="设置与外观" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="9.5"
                                       Foreground="#58617C" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============================ Content ============================ -->
        <Grid Grid.Column="1" Background="{StaticResource AppBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="30,16,20,0" Background="Transparent"
                  PreviewMouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Greeting}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        <Ellipse Width="3" Height="3" Fill="{StaticResource TextMutedBrush}" Margin="8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TodayLongDate}" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButtonStyle}" Content="&#xE921;"
                                ToolTip="最小化" Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource ChromeButtonStyle}"
                                ToolTip="最大化 / 还原" Click="MaximizeButton_Click">
                            <TextBlock x:Name="MaximizeGlyph" Text="&#xE922;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource ChromeCloseButtonStyle}" Content="&#xE8BB;"
                                ToolTip="关闭到托盘" Click="CloseButton_Click" Margin="2,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,11,0,0">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentBoardTitle}" FontSize="28" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <Border Background="{StaticResource BrandSoftBrush}" CornerRadius="8"
                                    Padding="8,3" Margin="12,4,0,0" VerticalAlignment="Top">
                                <TextBlock FontSize="10.5" Foreground="{StaticResource BrandBrush}" FontWeight="SemiBold">
                                    <Run Text="进行中 " />
                                    <Run Text="{Binding ActiveCount, Mode=OneWay}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayDoneCount, StringFormat=今天完成了 {0} 件事 · 右键或拖动可更改状态}"
                                   FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="1,5,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Width="246" Height="38" Style="{StaticResource SearchFieldBorderStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="SearchTextBox"
                                             Style="{StaticResource BorderlessTextBoxStyle}"
                                             Height="32"
                                             VerticalAlignment="Center"
                                             FontSize="12.5"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                    <TextBlock Text="搜索待办或分类…" FontSize="12.5"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               IsHitTestVisible="False" VerticalAlignment="Center"
                                               Visibility="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource EmptyStringVisibility}}" />
                                </Grid>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                        Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                        ToolTip="清空搜索"
                                        Visibility="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource StringVisibility}}"
                                        Click="ClearSearchButton_Click" />
                            </Grid>
                        </Border>

                        <Button Style="{StaticResource IconButtonStyle}"
                                Width="38" Height="38"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Margin="10,0,0,0"
                                ToolTip="设置与外观"
                                Click="OpenSettings_Click">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="15"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============================ Composer ============================ -->
            <Border Grid.Row="1" Margin="30,22,30,0"
                    Background="{StaticResource ComposerGlowBrush}"
                    BorderBrush="#E3E7F2"
                    BorderThickness="1"
                    CornerRadius="16"
                    Effect="{StaticResource SoftShadow}">
                <Grid Margin="16,14,16,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource BrandSoftBrush}"
                                VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{StaticResource BrandBrush}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="ComposerInput"
                                     Style="{StaticResource BorderlessTextBoxStyle}"
                                     FontSize="14.5"
                                     Height="34"
                                     MaxLength="200"
                                     VerticalAlignment="Center"
                                     Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                     PreviewKeyDown="ComposerInput_PreviewKeyDown" />
                            <TextBlock Text="写下一件要做的事… 按 Enter 快速添加"
                                       FontSize="14" Foreground="{StaticResource TextMutedBrush}"
                                       IsHitTestVisible="False" VerticalAlignment="Center"
                                       Visibility="{Binding Text, ElementName=ComposerInput, Converter={StaticResource EmptyStringVisibility}}" />
                        </Grid>
                    </Grid>

                    <Grid Grid.Row="1" Margin="42,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Style="{StaticResource AppComboBoxStyle}"
                                  Height="34"
                                  Width="166"
                                  ItemsSource="{Binding ComposerCategoryOptions}"
                                  SelectedItem="{Binding NewTaskCategoryOption, Mode=TwoWay}"
                                  ToolTip="选择分类" />

                        <ToggleButton Grid.Column="1"
                                      Style="{StaticResource PillToggleStyle}"
                                      Height="34"
                                      Margin="8,0,0,0"
                                      IsChecked="{Binding NewTaskUrgent, Mode=TwoWay}"
                                      ToolTip="把这件事标为紧急">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C1;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="紧急" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <TextBlock Grid.Column="2" Text="Enter 快速添加" FontSize="10"
                                   Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"
                                   Margin="14,0,0,0" />

                        <Button Grid.Column="3" Style="{StaticResource PrimaryButtonStyle}"
                                Height="34" MinWidth="92"
                                IsEnabled="{Binding CanAddNewTask}"
                                Click="AddTaskButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="添加待办" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================ Board ============================ -->
            <Grid Grid.Row="2" Margin="30,20,30,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Pending -->
                <Border x:Name="PendingColumn" Grid.Column="0" Margin="0,0,7,0" Background="{StaticResource ColumnPendingBrush}"
                        BorderBrush="#EAEDF5" BorderThickness="1" CornerRadius="16"
                        AllowDrop="True" Tag="Pending"
                        DragEnter="TaskColumn_DragEnter" DragOver="TaskColumn_DragOver"
                        DragLeave="TaskColumn_DragLeave" Drop="TaskColumn_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource PendingBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="未处理" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource ColumnPendingHeaderBrush}" CornerRadius="7"
                                        Padding="7,2" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PendingTasks.Count}" FontSize="10"
                                               Foreground="{StaticResource PendingBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Button Style="{StaticResource ColumnAddButtonStyle}" HorizontalAlignment="Right"
                                    Content="&#xE710;" ToolTip="添加未处理待办"
                                    Click="AddPendingButton_Click" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="12,4,7,10" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding PendingTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}" />
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding PendingTasks.Count, Converter={StaticResource ZeroVisibility}}">
                                <Border Width="54" Height="54" CornerRadius="18" Background="#FFF8EA"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE8FD;" Style="{StaticResource EmptyStateGlyphStyle}"
                                               Foreground="#DDA23C" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="没有待处理事项" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="添加一件想做的事吧" FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="PendingDropOverlay"
                                Grid.RowSpan="2"
                                Margin="5"
                                CornerRadius="13"
                                Background="#E6FFF9EA"
                                BorderBrush="{StaticResource PendingBrush}"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Panel.ZIndex="20">
                            <Border Background="{StaticResource PendingBrush}" CornerRadius="9"
                                    Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="松开移至未处理" Foreground="White"
                                           FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- Urgent -->
                <Border x:Name="UrgentColumn" Grid.Column="1" Margin="7,0" Background="{StaticResource ColumnUrgentBrush}"
                        BorderBrush="#F1E5E2" BorderThickness="1" CornerRadius="16"
                        AllowDrop="True" Tag="Urgent"
                        DragEnter="TaskColumn_DragEnter" DragOver="TaskColumn_DragOver"
                        DragLeave="TaskColumn_DragLeave" Drop="TaskColumn_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource UrgentBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="紧急" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource ColumnUrgentHeaderBrush}" CornerRadius="7"
                                        Padding="7,2" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding UrgentTasks.Count}" FontSize="10"
                                               Foreground="{StaticResource UrgentBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                            <Button Style="{StaticResource ColumnAddButtonStyle}" HorizontalAlignment="Right"
                                    Content="&#xE710;" ToolTip="添加紧急待办"
                                    Click="AddUrgentButton_Click" />
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="12,4,7,10" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding UrgentTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}" />
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding UrgentTasks.Count, Converter={StaticResource ZeroVisibility}}">
                                <Border Width="54" Height="54" CornerRadius="18" Background="{StaticResource UrgentSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE7C1;" Style="{StaticResource EmptyStateGlyphStyle}"
                                               Foreground="{StaticResource UrgentBrush}" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="暂时没有紧急事项" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="节奏刚刚好" FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="UrgentDropOverlay"
                                Grid.RowSpan="2"
                                Margin="5"
                                CornerRadius="13"
                                Background="#E6FFF4F1"
                                BorderBrush="{StaticResource UrgentBrush}"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Panel.ZIndex="20">
                            <Border Background="{StaticResource UrgentBrush}" CornerRadius="9"
                                    Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="松开移至紧急" Foreground="White"
                                           FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- Done -->
                <Border x:Name="DoneColumn" Grid.Column="2" Margin="7,0,0,0" Background="{StaticResource ColumnDoneBrush}"
                        BorderBrush="#E7F0EB" BorderThickness="1" CornerRadius="16"
                        AllowDrop="True" Tag="Done"
                        DragEnter="TaskColumn_DragEnter" DragOver="TaskColumn_DragOver"
                        DragLeave="TaskColumn_DragLeave" Drop="TaskColumn_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="16,0,16,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource DoneBrush}" Margin="0,0,9,0" />
                                <TextBlock Text="已处理" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{StaticResource ColumnDoneHeaderBrush}" CornerRadius="7"
                                        Padding="7,2" Margin="7,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DoneTasks.Count}" FontSize="10"
                                               Foreground="{StaticResource DoneBrush}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                          Margin="12,4,7,10" Padding="0,0,4,0">
                                <ItemsControl ItemsSource="{Binding DoneTasks}"
                                              ItemTemplate="{StaticResource TaskCardTemplate}" />
                            </ScrollViewer>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding DoneTasks.Count, Converter={StaticResource ZeroVisibility}}">
                                <Border Width="54" Height="54" CornerRadius="18" Background="{StaticResource DoneSoftBrush}"
                                        HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource EmptyStateGlyphStyle}"
                                               Foreground="{StaticResource DoneBrush}" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="还没有完成的事项" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="完成一件，就离轻松近一点" FontSize="10.5"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <Border x:Name="DoneDropOverlay"
                                Grid.RowSpan="2"
                                Margin="5"
                                CornerRadius="13"
                                Background="#E6EFFBF4"
                                BorderBrush="{StaticResource DoneBrush}"
                                BorderThickness="2"
                                Visibility="Collapsed"
                                IsHitTestVisible="False"
                                Panel.ZIndex="20">
                            <Border Background="{StaticResource DoneBrush}" CornerRadius="9"
                                    Padding="14,8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="松开移至已处理" Foreground="White"
                                           FontSize="12" FontWeight="SemiBold" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
